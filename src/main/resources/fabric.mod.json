{
  "schemaVersion": 1,
  "id": "chest_shield",
  "version": "${version}",
  "name": "Chest Shield",
  "description": "Chests only their owner can open, with permissions, an optional guest password and configurable hopper access.",
  "authors": [
    "mikkeljck"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/chest_shield/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mikkeljck.chestshield.CofresPersonales"
    ],
    "client": [
      "com.mikkeljck.chestshield.client.CofresPersonalesClient"
    ],
    "fabric-datagen": [
      "com.mikkeljck.chestshield.client.CofresPersonalesDataGenerator"
    ]
  },
  "mixins": [
    "chest_shield.mixins.json",
    {
      "config": "chest_shield.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}